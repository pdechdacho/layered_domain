# PFLOTRAN input deck for a UDFM DFNWorks thermal-flow example.
#
# This card solves single-phase subsurface flow with heat transport on the
# continuum mesh generated by DFNWorks. Matrix and fracture continuum cells are
# assigned different material properties. The left boundary is split into matrix
# and fracture inflow regions so that the fracture inflow can be colder than the
# surrounding matrix inflow.

# Sept 12, 2018
# Matthew Sweeney, Satish Karra, Jeffrey Hyman (LANL)
#==============================================================================

SIMULATION
  SIMULATION_TYPE SUBSURFACE

  PROCESS_MODELS
    # Transport is not used explicitly here. The thermal-hydrology process model
    # below handles liquid pressure and temperature.
    # SUBSURFACE_TRANSPORT transport
    #   MODE GIRT
    # /

    SUBSURFACE_FLOW flow
      # TH = thermal-hydrology mode. Solves pressure and temperature.
      MODE TH
    /

    # Optional steady-state block. Left commented because this example runs a
    # transient thermal problem.
    # OPTIONS
    #   STEADY_STATE
    # /
  /
END

SUBSURFACE

#=========================== discretization ===================================
GRID
  # DFNWorks writes the explicit unstructured grid file full_mesh.uge.
  TYPE unstructured_explicit full_mesh.uge

  # Turn off gravity so flow is driven only by pressure boundary conditions.
  GRAVITY 0.d0 0.d0 0.d0
END


#=========================== fluid properties =================================
FLUID_PROPERTY
  # Molecular diffusion coefficient. Included for completeness; this thermal-flow
  # setup is dominated by pressure and temperature conditions.
  DIFFUSION_COEFFICIENT 1.d-12
END

# Permeability and porosity are read from HDF5 files created by DFNWorks upscaling.
DATASET Permeability
  FILENAME mesh_permeability.h5
END

DATASET Porosity
  FILENAME mesh_porosity.h5
END


#=========================== material properties ==============================
# Matrix continuum material. Cells with material ID 1 are assigned these
# properties through the STRATA block at the end of the file.
MATERIAL_PROPERTY matrix
  ID 1
  POROSITY DATASET Porosity
  TORTUOSITY 0.1d0
  CHARACTERISTIC_CURVES default

  # Thermal properties for matrix material.
  ROCK_DENSITY 5000.0 kg/m^3
  SPECIFIC_HEAT 2
  THERMAL_CONDUCTIVITY_DRY 0.5
  THERMAL_CONDUCTIVITY_WET 0.5

  # Use upscaled permeability from DFNWorks.
  PERMEABILITY
    DATASET Permeability
  /
END


# Fracture continuum material. Cells with material ID 2 are assigned these
# properties. The porosity and permeability are still read from DFNWorks outputs,
# but thermal and tortuosity values differ from the matrix.
MATERIAL_PROPERTY fracture
  ID 2
  POROSITY DATASET Porosity
  TORTUOSITY 0.75d0
  CHARACTERISTIC_CURVES default

  # Thermal properties for fracture material.
  ROCK_DENSITY 2500.0 kg/m^3
  SPECIFIC_HEAT 2
  THERMAL_CONDUCTIVITY_DRY 1.5
  THERMAL_CONDUCTIVITY_WET 1.5

  # Use upscaled permeability from DFNWorks.
  PERMEABILITY
    DATASET Permeability
  /
END


#=========================== characteristic curves =============================
# Retention and relative permeability functions. These are required by PFLOTRAN's
# multiphase-style material model infrastructure even when the setup is intended
# to remain liquid saturated.
CHARACTERISTIC_CURVES default
  SATURATION_FUNCTION VAN_GENUCHTEN
    M 0.5d0
    ALPHA 1.d-4
    LIQUID_RESIDUAL_SATURATION 0.1d0
    MAX_CAPILLARY_PRESSURE 1.d8
  /

  PERMEABILITY_FUNCTION MUALEM_VG_LIQ
    M 0.5d0
    LIQUID_RESIDUAL_SATURATION 0.1d0
  /
END


#=========================== output options ===================================
OUTPUT
  # Write output every 0.1 years.
  PERIODIC TIME 1.0d-1 y

  # Include the primal grid in the output for visualization/post-processing.
  PRINT_PRIMAL_GRID

  # HDF5 output is expected by DFNWorks post-processing.
  FORMAT HDF5

  # Request mass-balance reporting.
  MASS_BALANCE

  # Variables to write to output files.
  VARIABLES
    LIQUID_PRESSURE
    PERMEABILITY_X
    PERMEABILITY_Y
    PERMEABILITY_Z
    POROSITY
    TEMPERATURE
  /
END


#=========================== times ============================================
TIME
  # Small initial step helps the nonlinear solver start robustly.
  INITIAL_TIMESTEP_SIZE 1.d-8 y

  # Simulate 10 years.
  FINAL_TIME 1.0d1 y

  # Cap the adaptive timestep at 1 year.
  MAXIMUM_TIMESTEP_SIZE 1.d0 y
END


#=========================== regions ==========================================
# Region covering the whole model domain. Used for the initial condition.
REGION All
  COORDINATES
    -5.d20 -5.d20 -5.d20
     5.d20  5.d20  5.d20
  /
END

# Full left boundary from DFNWorks. Kept here for reference; this example applies
# separate matrix/fracture inflow regions below instead of using this full region.
REGION inflow
  FILE boundary_left_w.ex
END

# Right boundary used for the pressure outflow condition.
REGION outflow
  FILE boundary_right_e.ex
END

# Left-boundary matrix cells, generated by the Python driver.
REGION matrix_left
  FILE matrix_left.ex
END

# Left-boundary fracture cells, generated by the Python driver.
REGION frac_left
  FILE frac_left.txt
END


#=========================== flow conditions ==================================
# Initial pressure and temperature everywhere in the domain.
FLOW_CONDITION INITIAL
  TYPE
    LIQUID_PRESSURE dirichlet
    TEMPERATURE dirichlet
  /
  LIQUID_PRESSURE 1.5d6
  TEMPERATURE 25.d0 C
END

# Right boundary pressure outlet. Temperature uses a zero-gradient condition so
# heat can leave without imposing a fixed outlet temperature.
FLOW_CONDITION OUTFLOW
  TYPE
    LIQUID_PRESSURE dirichlet
    TEMPERATURE zero_gradient
  /
  LIQUID_PRESSURE 1.0d6
  TEMPERATURE 25.d0 C
END

# Matrix portion of the left inflow boundary: warm inflow at 25 C.
FLOW_CONDITION inflow_matrix
  TYPE
    LIQUID_PRESSURE dirichlet
    TEMPERATURE dirichlet
  /
  LIQUID_PRESSURE 1.5d6
  TEMPERATURE 25.d0 C
END

# Fracture portion of the left inflow boundary: colder inflow at 5 C.
FLOW_CONDITION inflow_frac
  TYPE
    LIQUID_PRESSURE dirichlet
    TEMPERATURE dirichlet
  /
  LIQUID_PRESSURE 1.5d6
  TEMPERATURE 5.d0 C
END


#=========================== condition couplers ===============================
# Apply initial condition to the full domain.
INITIAL_CONDITION
  FLOW_CONDITION INITIAL
  REGION All
END

# Full inflow boundary condition is intentionally disabled because the left
# boundary is split into matrix and fracture inflow regions below.
# BOUNDARY_CONDITION INFLOW
#   FLOW_CONDITION INFLOW
#   REGION inflow
# END

# Apply outlet condition on the right boundary.
BOUNDARY_CONDITION OUTFLOW
  FLOW_CONDITION OUTFLOW
  REGION outflow
END

# Apply cold, prescribed fracture inflow on left-boundary fracture cells.
PRESCRIBED_CONDITION INFLOW_FRAC
  FLOW_CONDITION inflow_frac
  REGION frac_left
END

# Apply warm matrix inflow on left-boundary matrix cells.
BOUNDARY_CONDITION INFLOW_MATRIX
  FLOW_CONDITION inflow_matrix
  REGION matrix_left
END


#=========================== stratigraphy couplers ============================
# Map material IDs from materials.h5 onto the mesh. This assigns cells to the
# matrix or fracture MATERIAL_PROPERTY blocks above.
STRATA
  FILE materials.h5
END

END_SUBSURFACE
